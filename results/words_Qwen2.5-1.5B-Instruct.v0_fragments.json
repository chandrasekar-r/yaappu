[{"topic_no": 1, "topic": "கடவுள் வாழ்த்து", "mode": "baseline", "seed": 0, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "நோக்கம் திரு சீனிய கடவுள் வாழ்த்து\nநூற்றாண்டுகள் பலர் அது வாழ்த்தினர்", "time": 10.477367162704468, "tokens": 78, "status": "ok"}, {"topic_no": 1, "topic": "கடவுள் வாழ்த்து", "mode": "constrained", "seed": 0, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "உருவுகண்டு கட்டு வெளிப்படுந் தின்னும்\nநினைக்கப் பெரும்பொருள் மீன்", "time": 8.815378665924072, "tokens": 74, "backtracks": 0, "status": "ok"}, {"topic_no": 7, "topic": "மக்கட்பேறு", "mode": "baseline", "seed": 1, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "கோடிசிங்கார் வீர ஏற்படுக் பறாரூர்,\nதரைவர் முதல்யிராது நான் புத்தார்.", "time": 18.996861696243286, "tokens": 100, "status": "ok"}, {"topic_no": 7, "topic": "மக்கட்பேறு", "mode": "constrained", "seed": 1, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "கால்காட்டும் கால்காட்டும் பாக்கியத் தில்லை\nகதங்காத்துக் கால்காட்டும் இல்", "time": 8.5264310836792, "tokens": 83, "backtracks": 0, "status": "ok"}, {"topic_no": 14, "topic": "ஒழுக்கம் உடைமை", "mode": "baseline", "seed": 2, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "ஓழுக்கம் வேடி சோடுக் கரும் வீட்டு\nஉடன் பொனை முறைகள் அவனும்.", "time": 7.31065559387207, "tokens": 67, "status": "ok"}, {"topic_no": 14, "topic": "ஒழுக்கம் உடைமை", "mode": "constrained", "seed": 2, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "பிரித்தலும் ஒல்லாது பார்க்கும் உறுப்பொத்தல்\nவாறு நினைத்திருந்து மற்று", "time": 9.520699262619019, "tokens": 76, "backtracks": 0, "status": "ok"}, {"topic_no": 20, "topic": "பயனில சொல்லாமை", "mode": "baseline", "seed": 3, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "பயன்படி வீடிகள் வெற்றியிழம்பனோ\nஉட்பங்கள் மூட்டு நீரிடித்தனோ.", "time": 6.8274993896484375, "tokens": 69, "status": "ok"}, {"topic_no": 20, "topic": "பயனில சொல்லாமை", "mode": "constrained", "seed": 3, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "கால்காட்டும் கால்காட்டும் பெய்யும் பெயரினும்\nபார்த்துச் சொலினும் பெயின்", "time": 7.891859769821167, "tokens": 81, "backtracks": 0, "status": "ok"}, {"topic_no": 27, "topic": "தவம்", "mode": "baseline", "seed": 4, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "மாறி விசயம் தவம் திருவிளை,\nவணியின் மூத்து தவம் கண்ணோடி.", "time": 6.116702079772949, "tokens": 59, "status": "ok"}, {"topic_no": 27, "topic": "தவம்", "mode": "constrained", "seed": 4, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "ஒளியிழை தூக்கிச் உளதாகும் தேன்கலந்\nஒன்று கனியும் பெரிது", "time": 7.358102560043335, "tokens": 64, "backtracks": 0, "status": "ok"}, {"topic_no": 34, "topic": "நிலையாமை", "mode": "baseline", "seed": 5, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "ஏரோ சங்களின் வாழ்த்துக்கள் பின்னர் தீர்ந்து போன்றன,\nஉருகேட்டு விழுந்து திரும்பினான்.", "time": 9.570114612579346, "tokens": 94, "status": "ok"}, {"topic_no": 34, "topic": "நிலையாமை", "mode": "constrained", "seed": 5, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "நிலையாமை நில்லாத போல்வர் தொடங்கார்\nபுனையினும் கூடாதே இல்", "time": 6.4574925899505615, "tokens": 70, "backtracks": 0, "status": "ok"}, {"topic_no": 40, "topic": "கல்வி", "mode": "baseline", "seed": 6, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "புதிய கல்வி மூலம் சுமீர்ச்சியிழும் பரங்கள்\nபாலான் பல்வேறு தோல்கள் சுவாஷன்.", "time": 8.687798976898193, "tokens": 84, "status": "ok"}, {"topic_no": 40, "topic": "கல்வி", "mode": "constrained", "seed": 6, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "பிரித்தலும் நண்பாற்றார் பாத்தியுள் மீன்விழுங்கி\nமுட்டாச் செயற்பால பால்", "time": 8.300301551818848, "tokens": 80, "backtracks": 0, "status": "ok"}, {"topic_no": 47, "topic": "தெரிந்து செயல்வகை", "mode": "baseline", "seed": 7, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "வணைத்து உணர்ந்து தூக்கப்பட்டு முறைக்கொண்டு\nதங்கித்து துருவித்து பிறகு வழக்கியது", "time": 9.701634883880615, "tokens": 85, "status": "ok"}, {"topic_no": 47, "topic": "தெரிந்து செயல்வகை", "mode": "constrained", "seed": 7, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "பரிந்துள்ளல் துவ்வாய்காண் சூழ்ந்து கிளைஞரை\nகுற்றம் செயலாற்றும் மாறு", "time": 7.520386457443237, "tokens": 77, "backtracks": 0, "status": "ok"}, {"topic_no": 54, "topic": "பொச்சாவாமை", "mode": "baseline", "seed": 8, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "பொச்சாவாமை அவன் வீடிக்கு சூட்டிக்கொண்டு\nபின்னர் விளோட்டுக் கொண்டிருந்தான்கள்.", "time": 8.847033739089966, "tokens": 89, "status": "ok"}, {"topic_no": 54, "topic": "பொச்சாவாமை", "mode": "constrained", "seed": 8, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "உருகும் முகமொத்தி வெள்ளத் தடிந்தெழிலி\nநான்கும் பொறுத்தல் வெளிறு", "time": 8.047244787216187, "tokens": 72, "backtracks": 0, "status": "ok"}, {"topic_no": 60, "topic": "ஊக்கம் உடைமை", "mode": "baseline", "seed": 9, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "ஓக்க சுகங்கு விளக்கத்தோல்\nபீடங்கொன்று பட்டிஸ்தான்.", "time": 9.103373527526855, "tokens": 57, "status": "ok"}, {"topic_no": 60, "topic": "ஊக்கம் உடைமை", "mode": "constrained", "seed": 9, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "புகுத்தி பொதுநோக்கான் நேர்வது நூற்கும்\nஒறுக்கிற் நெருநல் வெளிறு", "time": 15.20940899848938, "tokens": 74, "backtracks": 0, "status": "ok"}, {"topic_no": 67, "topic": "வினைத்திட்பம்", "mode": "baseline", "seed": 10, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "பிற சுவரின் வினைத்திட்பத்து வந்தால்\nஉலக் மூலம் பிற சுவர் செய்து", "time": 11.313292741775513, "tokens": 100, "status": "ok"}, {"topic_no": 67, "topic": "வினைத்திட்பம்", "mode": "constrained", "seed": 10, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "வினைத்திட்பம் பண்டுடையேன் மண்ணும் நினைத்தொன்று\nசூழாது பிற்பயக்கும் சூழ்ந்து", "time": 7.644706726074219, "tokens": 84, "backtracks": 0, "status": "ok"}, {"topic_no": 74, "topic": "நாடு", "mode": "baseline", "seed": 11, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "கால் சூழ்வு நாட்கள் நீர்,\nபோது விழுங்கி மேல் தான்.", "time": 7.059178352355957, "tokens": 58, "status": "ok"}, {"topic_no": 74, "topic": "நாடு", "mode": "constrained", "seed": 11, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "பல்லுயிர் முற்றும் வெளியார்முன் நாகரிகம்\nஉல்கு பொறுத்து நெறி", "time": 6.561062335968018, "tokens": 67, "backtracks": 0, "status": "ok"}, {"topic_no": 80, "topic": "நட்பாராய்தல்", "mode": "baseline", "seed": 12, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "கண்டு சீர் வங்கூரி அரசிட்டு\nமுகம் பிள்ளை போர்த்துள்ளது.", "time": 6.693439483642578, "tokens": 61, "status": "ok"}, {"topic_no": 80, "topic": "நட்பாராய்தல்", "mode": "constrained", "seed": 12, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "நட்பாள் கணிச்சி செயல்வேண்டும் பண்டுடையேன்\nநட்பாள் மறுத்தின்னா செய்து", "time": 7.321925401687622, "tokens": 79, "backtracks": 0, "status": "ok"}, {"topic_no": 87, "topic": "பகை மாட்சி", "mode": "baseline", "seed": 13, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "பகை மாட்சி விளங்கு அறை அமைதி,\nதுவார் திருக்கு வீழ்ச்சி சூழ்ந்து.", "time": 7.322775602340698, "tokens": 72, "status": "ok"}, {"topic_no": 87, "topic": "பகை மாட்சி", "mode": "constrained", "seed": 13, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "பாக்கியத் தாங்கும் பனிவாரும் பாக்கியத்\nநான்கின் மொழியின் பரந்து", "time": 7.420632600784302, "tokens": 73, "backtracks": 0, "status": "ok"}, {"topic_no": 94, "topic": "சூது", "mode": "baseline", "seed": 14, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "சூது வீட்டு விழுங்க தன்மை விளைவு,\nகால்முடி குமார சூத்தி விளங்கும்.", "time": 7.064595460891724, "tokens": 75, "status": "ok"}, {"topic_no": 94, "topic": "சூது", "mode": "constrained", "seed": 14, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "சூது தனியே பெருமை செயல்வேண்டும்\nவள்ளி செயல்வேண்டும் மீன்", "time": 7.363790035247803, "tokens": 66, "backtracks": 0, "status": "ok"}, {"topic_no": 100, "topic": "பண்புடைமை", "mode": "baseline", "seed": 15, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "நிகழ்ச்சி வீழ்ச்சி அதிகமானது நிகழ்வு\nகட்டுறை சூழ்ந்த நோக்கள் மீது.", "time": 7.508593320846558, "tokens": 74, "status": "ok"}, {"topic_no": 100, "topic": "பண்புடைமை", "mode": "constrained", "seed": 15, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "ராகி தலைவந்த மல்லன்மா ஆராய்ந்து\nஅகர மறையிறந்து நாற்", "time": 5.411977529525757, "tokens": 60, "backtracks": 0, "status": "ok"}, {"topic_no": 107, "topic": "இரவச்சம்", "mode": "baseline", "seed": 16, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "இரவச்சம் வழிந்து கோடிகள்\nஉற்பத்தியாக நீங்கள் அவர்கள்", "time": 9.606861114501953, "tokens": 100, "status": "ok"}, {"topic_no": 107, "topic": "இரவச்சம்", "mode": "constrained", "seed": 16, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "கடலைச் சொலினும் செலவிடா பெண்மை\nதடிந்தெழிலி வென்றதூஉம் ஆறு", "time": 6.250579595565796, "tokens": 68, "backtracks": 0, "status": "ok"}, {"topic_no": 114, "topic": "நாணுத் துறவுரைத்தல்", "mode": "baseline", "seed": 17, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "நாணு சூழ்வில் துறையினை நிலை\nஞானம் சூழ்வில் துறையினை கலை", "time": 7.471926927566528, "tokens": 68, "status": "ok"}, {"topic_no": 114, "topic": "நாணுத் துறவுரைத்தல்", "mode": "constrained", "seed": 17, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "உழுதுண்டு வான்சுதை இட்டன்ன வீழ்நாள்\nபொருளுடைமை சுற்றும் பெறின்", "time": 8.510809659957886, "tokens": 72, "backtracks": 0, "status": "ok"}, {"topic_no": 120, "topic": "தனிப்படர் மிகுதி", "mode": "baseline", "seed": 18, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "நான் சூலோகம் வருகிறீர்கள்,\nதான் துபங்கிழியின் கொலோன்றுக்களே.", "time": 11.467466592788696, "tokens": 70, "status": "ok"}, {"topic_no": 120, "topic": "தனிப்படர் மிகுதி", "mode": "constrained", "seed": 18, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "பின்னூறு கில்லை தனிமை சுடப்படினும்\nநில்லன்மின் ஒல்கார் வெளிறு", "time": 9.12891149520874, "tokens": 68, "backtracks": 0, "status": "ok"}, {"topic_no": 127, "topic": "அவர்வயின் விதும்பல்", "mode": "baseline", "seed": 19, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "ஓவர்வோவர்வோ சாகிஂர் கீழே நார்ஸ்த\nஉட்கள் உட்கள் அவர் விடையில் சீனா.", "time": 7.574169158935547, "tokens": 77, "status": "ok"}, {"topic_no": 127, "topic": "அவர்வயின் விதும்பல்", "mode": "constrained", "seed": 19, "model": "Qwen/Qwen2.5-1.5B-Instruct", "text": "வெளியார்முன் கண்டுகேட்டு வட்டாடி கண்டனைய\nஇன்று கணிச்சி கணி", "time": 5.99098539352417, "tokens": 64, "backtracks": 0, "status": "ok"}]
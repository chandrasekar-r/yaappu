ோடும் தூக்கம் தானும்,\nநன்நெஞ்சம் தவம் வேதர்.", "time": 4.648352384567261, "tokens": 31, "status": "ok"}, {"topic_no": 27, "topic": "தவம்", "mode": "constrained", "seed": 4, "model": "unsloth/gemma-2-2b-it", "text": "நல்ல மனத்து வழிநோக்கான் ஓரா\nபலர்நின்று கண்டனைய ஓஒ", "time": 4.88028621673584, "tokens": 29, "backtracks": 0, "status": "ok"}, {"topic_no": 27, "topic": "தவம்", "mode": "baseline", "seed": 1004, "model": "unsloth/gemma-2-2b-it", "text": "தவம் பூர்த்தி வானில்\nபூமிக்கு மகிழ்வும்.", "time": 3.997323751449585, "tokens": 26, "status": "ok"}, {"topic_no": 27, "topic": "தவம்", "mode": "constrained", "seed": 1004, "model": "unsloth/gemma-2-2b-it", "text": "வானம் தவம்இரண்டும் ஓர்ந்துகண் ஈர்ங்கை\nஅறியாமை உப்பு தவம்", "time": 5.233046054840088, "tokens": 32, "backtracks": 0, "status": "ok"}, {"topic_no": 27, "topic": "தவம்", "mode": "baseline", "seed": 2004, "model": "unsloth/gemma-2-2b-it", "text": "வானம் தோன்றும் சீர்வால்\nசூழ்ந்து உயிர்க்கு மறைய.", "time": 5.9148125648498535, "tokens": 34, "status": "ok"}, {"topic_no": 27, "topic": "தவம்", "mode": "constrained", "seed": 2004, "model": "unsloth/gemma-2-2b-it", "text": "வஞ்சிப்ப திண்ணியர் தீர்ந்தாரும் ஈரம்\nதவம்இரண்டும் ஓர்ந்துகண் னாள்", "time": 6.540912628173828, "tokens": 37, "backtracks": 0, "status": "ok"}, {"topic_no": 34, "topic": "நிலையாமை", "mode": "baseline", "seed": 5, "model": "unsloth/gemma-2-2b-it", "text": "நிலையாமை நிலை,\nதொடர்ந்து சிறுகி விடும்.", "time": 4.8005876541137695, "tokens": 29, "status": "ok"}, {"topic_no": 34, "topic": "நிலையாமை", "mode": "constrained", "seed": 5, "model": "unsloth/gemma-2-2b-it", "text": "நிலையாமை சூழ்ந்தும் ரிழைத்துணர்ந் ஈரம்\nகனவிலும் மன்னன் தலை", "time": 4.970205783843994, "tokens": 35, "backtracks": 0, "status": "ok"}, {"topic_no": 34, "topic": "நிலையாமை", "mode": "baseline", "seed": 1005, "model": "unsloth/gemma-2-2b-it", "text": "நிலையாமை மனம் உணர்ந்தது,\nகண்ணே உள மலை.", "time": 5.221790552139282, "tokens": 26, "status": "ok"}, {"topic_no": 34, "topic": "நிலையாமை", "mode": "constrained", "seed": 1005, "model": "unsloth/gemma-2-2b-it", "text": "வானகமும் பூவொக்கும் போல்வர் னவைநீக்கி\nசூழும் சிலர்பலர் சோர்வு", "time": 5.580281734466553, "tokens": 36, "backtracks": 0, "status": "ok"}, {"topic_no": 34, "topic": "நிலையாமை", "mode": "baseline", "seed": 2005, "model": "unsloth/gemma-2-2b-it", "text": "சொல்லும் பாதம் வேலைகேடாய்\nநினைவு மின்னும் தோன்றி.", "time": 4.390863656997681, "tokens": 30, "status": "ok"}, {"topic_no": 34, "topic": "நிலையாமை", "mode": "constrained", "seed": 2005, "model": "unsloth/gemma-2-2b-it", "text": "சொல்லா விடாஅர் நிலையாமை ளெல்லாம்\nகொடியர் களவல்ல காப்பு", "time": 4.068685293197632, "tokens": 30, "backtracks": 0, "status": "ok"}, {"topic_no": 40, "topic": "கல்வி", "mode": "baseline", "seed": 6, "model": "unsloth/gemma-2-2b-it", "text": "கல்வி நன்மொழி கண்னம்\nஉயிர் வழியும் காலம்.", "time": 4.350342273712158, "tokens": 28, "status": "ok"}, {"topic_no": 40, "topic": "கல்வி", "mode": "constrained", "seed": 6, "model": "unsloth/gemma-2-2b-it", "text": "கல்வி அறம்நாணத் தொல்லைக்கண் ஓர்ந்துகண்\nதொல்லைக்கண் ஓர்ந்துகண் ஓஒ", "time": 5.892063140869141, "tokens": 38, "backtracks": 0, "status": "ok"}, {"topic_no": 40, "topic": "கல்வி", "mode": "baseline", "seed": 1006, "model": "unsloth/gemma-2-2b-it", "text": "கல்வி வண்ணம் உலகம் அழகு\nநெறி உள்ள மனம் கற்ற.", "time": 4.497772693634033, "tokens": 26, "status": "ok"}, {"topic_no": 40, "topic": "கல்வி", "mode": "constrained", "seed": 1006, "model": "unsloth/gemma-2-2b-it", "text": "அறிவு களவல்ல மன்கொல் லினதே\nயுடையார் உணர்வார்ப் பலர்", "time": 6.782118797302246, "tokens": 31, "backtracks": 0, "status": "ok"}, {"topic_no": 40, "topic": "கல்வி", "mode": "baseline", "seed": 2006, "model": "unsloth/gemma-2-2b-it", "text": "கல்வி உணர்ச்சி மெருகேடு\nதொகை தவிர்ந்த உன்னை.", "time": 4.937579393386841, "tokens": 31, "status": "ok"}, {"topic_no": 40, "topic": "கல்வி", "mode": "constrained", "seed": 2006, "model": "unsloth/gemma-2-2b-it", "text": "கல்வி புணர்ந்தூடி கட்டளைக் கட்காதல்\nசிற்றின்பம் அன்றே பரந்து", "time": 4.7041168212890625, "tokens": 31, "backtracks": 0, "status": "ok"}, {"topic_no": 47, "topic": "தெரிந்து செயல்வகை", "mode": "baseline", "seed": 7, "model": "unsloth/gemma-2-2b-it", "text": "துருவுனில் தும்பை சாலை\nகொடை போகப் பணி முடி.", "time": 5.973430156707764, "tokens": 29, "status": "ok"}, {"topic_no": 47, "topic": "தெரிந்து செயல்வகை", "mode": "constrained", "seed": 7, "model": "unsloth/gemma-2-2b-it", "text": "முதல துயர்வரவு கான மொழியின்\nகொடையளி பல்குழுவும் உய்த்து", "time": 7.463496923446655, "tokens": 30, "backtracks": 0, "status": "ok"}, {"topic_no": 47, "topic": "தெரிந்து செயல்வகை", "mode": "baseline", "seed": 1007, "model": "unsloth/gemma-2-2b-it", "text": "தருளப் பின்ன ConſImageContext.\nசெயல் பின்னர் திட்டம்.", "time": 7.27427339553833, "tokens": 26, "status": "ok"}, {"topic_no": 47, "topic": "தெரிந்து செயல்வகை", "mode": "constrained", "seed": 1007, "model": "unsloth/gemma-2-2b-it", "text": "கண்விளங்கும் மெல்ல சிலர்அதன் ஓர்ந்துகண்\nதொல்கவின் அம்பினில் தோள்", "time": 5.009762525558472, "tokens": 36, "backtracks": 0, "status": "ok"}, {"topic_no": 47, "topic": "தெரிந்து செயல்வகை", "mode": "baseline", "seed": 2007, "model": "unsloth/gemma-2-2b-it", "text": "உனை மனம் பரிசும்படி பின்\nகாரியம் செய்யும்பின் மனம்.", "time": 4.742403507232666, "tokens": 32, "status": "ok"}, {"topic_no": 47, "topic": "தெரிந்து செயல்வகை", "mode": "constrained", "seed": 2007, "model": "unsloth/gemma-2-2b-it", "text": "நெருப்பினுள் நீர்சொரிந் தீர்த்தல் றதுபோலும்\nசெய்க பழகிய பின்", "time": 4.9941582679748535, "tokens": 35, "backtracks": 0, "status": "ok"}, {"topic_no": 54, "topic": "பொச்சாவாமை", "mode": "baseline", "seed": 8, "model": "unsloth/gemma-2-2b-it", "text": "பிற்காலம் போகும், நும்மாநிலம்\nஉள் மொழி தீர்வாம்.", "time": 4.739954710006714, "tokens": 30, "status": "ok"}, {"topic_no": 54, "topic": "பொச்சாவாமை", "mode": "constrained", "seed": 8, "model": "unsloth/gemma-2-2b-it", "text": "உலகின் கருவியும் நிச்ச திருவினை\nமாரி தலைவந்த பண்பு", "time": 3.5855166912078857, "tokens": 26, "backtracks": 0, "status": "ok"}, {"topic_no": 54, "topic": "பொச்சாவாமை", "mode": "baseline", "seed": 1008, "model": "unsloth/gemma-2-2b-it", "text": "வானம் பழனி மெய்யும் கரை\nஉள்ளேயுறும் சின்னம்.", "time": 3.889052391052246, "tokens": 28, "status": "ok"}, {"topic_no": 54, "topic": "பொச்சாவாமை", "mode": "constrained", "seed": 1008, "model": "unsloth/gemma-2-2b-it", "text": "சொல்லும் மனத்து நெறிநின்றார் ஈர்ங்கை\nகொடுமை மறந்தும் இனிது", "time": 4.137260437011719, "tokens": 31, "backtracks": 0, "status": "ok"}, {"topic_no": 54, "topic": "பொச்சாவாமை", "mode": "baseline", "seed": 2008, "model": "unsloth/gemma-2-2b-it", "text": "சிவபெருமான் வரைபடத்தை நினைவு\nகும்பல் நிகழ்ச்சிக்கு அருள்.", "time": 4.616588115692139, "tokens": 33, "status": "ok"}, {"topic_no": 54, "topic": "பொச்சாவாமை", "mode": "constrained", "seed": 2008, "model": "unsloth/gemma-2-2b-it", "text": "மூன்று கதவு மனத்தொடு கற்றுக்கண்\nபொச்சாப்புக் காதல் பரந்து", "time": 3.952285051345825, "tokens": 30, "backtracks": 0, "status": "ok"}, {"topic_no": 60, "topic": "ஊக்கம் உடைமை", "mode": "baseline", "seed": 9, "model": "unsloth/gemma-2-2b-it", "text": "உயர்ந்த சக்தி தோன்றி\nபலன் கடந்தகே.", "time": 3.575489044189453, "tokens": 25, "status": "ok"}, {"topic_no": 60, "topic": "ஊக்கம் உடைமை", "mode": "constrained", "seed": 9, "model": "unsloth/gemma-2-2b-it", "text": "உழைப்பிரிந்து காத்த இனிய னவைநீக்கி\nகொண்கனைக் கண்டது உயர்வு", "time": 5.595004558563232, "tokens": 34, "backtracks": 0, "status": "ok"}, {"topic_no": 60, "topic": "ஊக்கம் உடைமை", "mode": "baseline", "seed": 1009, "model": "unsloth/gemma-2-2b-it", "text": "ஊக்கம் உடைமை களை\nபகர்ந்தன் ஓர்.", "time": 3.323657512664795, "tokens": 22, "status": "ok"}, {"topic_no": 60, "topic": "ஊக்கம் உடைமை", "mode": "constrained", "seed": 1009, "model": "unsloth/gemma-2-2b-it", "text": "ஊக்கம் உடைமை மணந்தார் னவைநீக்கி\nசூழ்ந்து வணங்கிய மார்பு", "time": 4.369575500488281, "tokens": 30, "backtracks": 0, "status": "ok"}, {"topic_no": 60, "topic": "ஊக்கம் உடைமை", "mode": "baseline", "seed": 2009, "model": "unsloth/gemma-2-2b-it", "text": "பூமியின் வாயில் உதை\nஉள்ளார் ஊக்கம் தரும.", "time": 4.597663879394531, "tokens": 24, "status": "ok"}, {"topic_no": 60, "topic": "ஊக்கம் உடைமை", "mode": "constrained", "seed": 2009, "model": "unsloth/gemma-2-2b-it", "text": "ஊக்கம் உடைமை தகைத்தே லதனை\nசொலினும் இதனால் நெறி", "time": 3.7337534427642822, "tokens": 29, "backtracks": 0, "status": "ok"}, {"topic_no": 67, "topic": "வினைத்திட்பம்", "mode": "baseline", "seed": 10, "model": "unsloth/gemma-2-2b-it", "text": "வானம் தானே அமைந்தது\nவினைத்திட்டம் தீர்க்கம்.", "time": 3.863629102706909, "tokens": 27, "status": "ok"}, {"topic_no": 67, "topic": "வினைத்திட்பம்", "mode": "constrained", "seed": 10, "model": "unsloth/gemma-2-2b-it", "text": "வானம் விரித்துரையா இன்பம் லதனை\nஉதவி செயல்வேண்டும் மீன்", "time": 4.0977699756622314, "tokens": 29, "backtracks": 0, "status": "ok"}, {"topic_no": 67, "topic": "வினைத்திட்பம்", "mode": "baseline", "seed": 1010, "model": "unsloth/gemma-2-2b-it", "text": "வானம் பூக்கள் தோழன்,\nவினைத்திட்டம் தந்தி.", "time": 4.208175897598267, "tokens": 27, "status": "ok"}, {"topic_no": 67, "topic": "வினைத்திட்பம்", "mode": "constrained", "seed": 1010, "model": "unsloth/gemma-2-2b-it", "text": "விரைந்து செயல்வேண்டும் கெட்ட நயன்சாரா\nஅன்புசார் செய்ந்நன்றி வித்து", "time": 4.936231851577759, "tokens": 33, "backtracks": 0, "status": "ok"}, {"topic_no": 67, "topic": "வினைத்திட்பம்", "mode": "baseline", "seed": 2010, "model": "unsloth/gemma-2-2b-it", "text": "கோள் உருக்கி பழி வாறும்\nவார்த்தை இதக லங்கும்.", "time": 4.228148460388184, "tokens": 28, "status": "ok"}, {"topic_no": 67, "topic": "வினைத்திட்பம்", "mode": "constrained", "seed": 2010, "model": "unsloth/gemma-2-2b-it", "text": "உள்ள மணியில் மழலைச்சொல் ஓர்த்துள்ளம்\nவிண்இன்று தோன்றி பொருள்", "time": 4.414835691452026, "tokens": 32, "backtracks": 0, "status": "ok"}, {"topic_no": 74, "topic": "நாடு", "mode": "baseline", "seed": 11, "model": "unsloth/gemma-2-2b-it", "text": "நெஞ்சம் தோன்றிய நாடு\nசும்மா மணி வீசு.", "time": 4.3598792552948, "tokens": 24, "status": "ok"}, {"topic_no": 74, "topic": "நாடு", "mode": "constrained", "seed": 11, "model": "unsloth/gemma-2-2b-it", "text": "நாடு பரிந்துணராப் ஈந்ததிவ் ஓர்ந்துகண்\nதொல்படைக் காரணம் பாடு", "time": 5.176414489746094, "tokens": 34, "backtracks": 0, "status": "ok"}, {"topic_no": 74, "topic": "நாடு", "mode": "baseline", "seed": 1011, "model": "unsloth/gemma-2-2b-it", "text": "நாடு  மறுத்தால்  அழகு.", "time": 4.173689842224121, "tokens": 28, "status": "ok"}, {"topic_no": 74, "topic": "நாடு", "mode": "constrained", "seed": 1011, "model": "unsloth/gemma-2-2b-it", "text": "நாடு மனத்தின் உலகு னவைநீக்கி\nஅன்பும் புலியின்தோல் சோர்வு", "time": 5.9576475620269775, "tokens": 33, "backtracks": 0, "status": "ok"}, {"topic_no": 74, "topic": "நாடு", "mode": "baseline", "seed": 2011, "model": "unsloth/gemma-2-2b-it", "text": "நாடு மனம் வியர்த்துப் பிறக்கும்\nஉயிர் ஓர் கல்லைகள்.", "time": 5.093470335006714, "tokens": 32, "status": "ok"}, {"topic_no": 74, "topic": "நாடு", "mode": "constrained", "seed": 2011, "model": "unsloth/gemma-2-2b-it", "text": "வானம் படியுடையார் நாடு னவைநீக்கி\nவானம் வசையென்ப நூல்", "time": 4.923990488052368, "tokens": 30, "backtracks": 0, "status": "ok"}, {"topic_no": 80, "topic": "நட்பாராய்தல்", "mode": "baseline", "seed": 12, "model": "unsloth/gemma-2-2b-it", "text": "மனம் திறந்தே நெஞ்சம் வண்ணம்\nசொல்வனவன் இன் நடுக்கே.", "time": 7.229437351226807, "tokens": 32, "status": "ok"}, {"topic_no": 80, "topic": "நட்பாராய்தல்", "mode": "constrained", "seed": 12, "model": "unsloth/gemma-2-2b-it", "text": "உள்ளம் உறங்கி படிவத்த லோர்க்கும்\nசொலினும் நகைவகைய லின்று", "time": 10.15018892288208, "tokens": 34, "backtracks": 0, "status": "ok"}, {"topic_no": 80, "topic": "நட்பாராய்தல்", "mode": "baseline", "seed": 1012, "model": "unsloth/gemma-2-2b-it", "text": "நண்பர்க்கு புணர்ந்தால் மருகு\nசேர்ந்த நண்பர் பிரம்மம்.", "time": 5.686913251876831, "tokens": 31, "status": "ok"}, {"topic_no": 80, "topic": "நட்பாராய்தல்", "mode": "constrained", "seed": 1012, "model": "unsloth/gemma-2-2b-it", "text": "வன்கண் துணையாகச் சேர்ந்த நெறிநின்றார்\nநட்பின் வழிநோக்கான் இன்று", "time": 5.900303840637207, "tokens": 33, "backtracks": 0, "status": "ok"}, {"topic_no": 80, "topic": "நட்பாராய்தல்", "mode": "baseline", "seed": 2012, "model": "unsloth/gemma-2-2b-it", "text": "நண்பர்க்கு பரிச்சயம் செய்து\nகாத்துக்கொண்டு நெருங்கி.", "time": 4.285323619842529, "tokens": 29, "status": "ok"}, {"topic_no": 80, "topic": "நட்பாராய்தல்", "mode": "constrained", "seed": 2012, "model": "unsloth/gemma-2-2b-it", "text": "நன்மையும் நெஞ்சம் உணர்ந்தும் றதுபோலும்\nநட்பரண் வல்ல பிறர்", "time": 4.518978834152222, "tokens": 31, "backtracks": 0, "status": "ok"}, {"topic_no": 87, "topic": "பகை மாட்சி", "mode": "baseline", "seed": 13, "model": "unsloth/gemma-2-2b-it", "text": "பகை மாட்சி கரையாள் கருள்\nசேய் துன்பம் தூக்கி வென்று.", "time": 4.527887344360352, "tokens": 32, "status": "ok"}, {"topic_no": 87, "topic": "பகை மாட்சி", "mode": "constrained", "seed": 13, "model": "unsloth/gemma-2-2b-it", "text": "பாக்கியத் தீர்ப்பான் கெடுங்காலைக் கற்ற\nவணங்கிய வண்ணம் உயிர்", "time": 3.9895074367523193, "tokens": 31, "backtracks": 0, "status": "ok"}, {"topic_no": 87, "topic": "பகை மாட்சி", "mode": "baseline", "seed": 1013, "model": "unsloth/gemma-2-2b-it", "text": "பகை மாட்சி எழுவது மானம்\nஉனக்குத் தோல்வியே கலக்க.", "time": 4.274028062820435, "tokens": 32, "status": "ok"}, {"topic_no": 87, "topic": "பகை மாட்சி", "mode": "constrained", "seed": 1013, "model": "unsloth/gemma-2-2b-it", "text": "வடுக்காண மன்கொல் நெருப்பினுள் ஓடா\nபகைமையும் பூதங்கள் பின்", "time": 5.984080076217651, "tokens": 34, "backtracks": 0, "status": "ok"}, {"topic_no": 87, "topic": "பகை மாட்சி", "mode": "baseline", "seed": 2013, "model": "unsloth/gemma-2-2b-it", "text": "வெறும் அருள் தூக்கி பகை\nமறந்து மணமும் கலக்க.", "time": 3.6974525451660156, "tokens": 28, "status": "ok"}, {"topic_no": 87, "topic": "பகை மாட்சி", "mode": "constrained", "seed": 2013, "model": "unsloth/gemma-2-2b-it", "text": "கண்டனைய நேர்வது பூசல் லதனை\nஉயிர்மருட்டி தீர்ப்பான் லது", "time": 4.63076376914978, "tokens": 34, "backtracks": 0, "status": "ok"}, {"topic_no": 94, "topic": "சூது", "mode": "baseline", "seed": 14, "model": "unsloth/gemma-2-2b-it", "text": "சொல் தருக சாமன் மகிழும்\nகோள் சாரும் ஆழ்வார் பூ.", "time": 4.383575677871704, "tokens": 31, "status": "ok"}, {"topic_no": 94, "topic": "சூது", "mode": "constrained", "seed": 14, "model": "unsloth/gemma-2-2b-it", "text": "சோர்விலாள் நொந்து துறக்க லினதே\nவிளையுளும் நோக்கிய பால்", "time": 4.0254998207092285, "tokens": 31, "backtracks": 0, "status": "ok"}, {"topic_no": 94, "topic": "சூது", "mode": "baseline", "seed": 1014, "model": "unsloth/gemma-2-2b-it", "text": "சோகத்தை நோக்கிச் சூது\nசெந்தோழிப் பூன் விளையா.", "time": 4.234994173049927, "tokens": 29, "status": "ok"}, {"topic_no": 94, "topic": "சூது", "mode": "constrained", "seed": 1014, "model": "unsloth/gemma-2-2b-it", "text": "சூது லதனை அறைபறை ஐயம்\nகொடுப்பது புன்னலம் மீன்", "time": 4.412036418914795, "tokens": 29, "backtracks": 0, "status": "ok"}, {"topic_no": 94, "topic": "சூது", "mode": "baseline", "seed": 2014, "model": "unsloth/gemma-2-2b-it", "text": "சூது காணும் மனம் கறும்\nசங்கை நோக்கும் தஞ்சம்.", "time": 4.355363130569458, "tokens": 27, "status": "ok"}, {"topic_no": 94, "topic": "சூது", "mode": "constrained", "seed": 2014, "model": "unsloth/gemma-2-2b-it", "text": "சூது மிகுதிக்கண் நெஞ்சம் ளவட்கு\nகருவி திரியாது மீன்", "time": 5.1059277057647705, "tokens": 31, "backtracks": 0, "status": "ok"}, {"topic_no": 100, "topic": "பண்புடைமை", "mode": "baseline", "seed": 15, "model": "unsloth/gemma-2-2b-it", "text": "செல்லா தளம் திகழ்ந்த நண்பர்\nகுடும்பம் கருதி கழித்து.", "time": 4.6158058643341064, "tokens": 31, "status": "ok"}, {"topic_no": 100, "topic": "பண்புடைமை", "mode": "constrained", "seed": 15, "model": "unsloth/gemma-2-2b-it", "text": "இன்பம் செலவிடா வைத்திழக்கும் ஐயம்\nசொலினும் தருவதொன் கென்று", "time": 4.51